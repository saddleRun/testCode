{
    "window.zoomLevel": 2,
    "files.watcherExclude": {
        "**/.bloop": true,
        "**/.metals": true,
        "**/.ammonite": true
    },
    "java.jdt.ls.java.home": "/usr/lib/jvm/java-21-openjdk-amd64",
    // "java.home" : "/usr/lib/jvm/java-17-openjdk-amd64",
    // "metals.javaHome": "/usr/lib/jvm/java-17-openjdk-amd64",
    "editor.suggestSelection": "first",
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
    "security.workspace.trust.untrustedFiles": "open",
    "workbench.editorAssociations": {
        "*.class": "default"
    },
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-17",
            "path": "/usr/lib/jvm/java-17-openjdk-amd64", // Replace with your actual path
            // "default": true // Set to true if you want this as the default JDK
        },
        {
            "name": "JavaSE-21",
            "path": "/usr/lib/jvm/java-21-openjdk-amd64", // Replace with your actual path
            "default": true, // Set to true if you want this as the default JDK
            "sources": "/usr/lib/jvm/openjdk-21/src.zip",
            "javadoc" : "https://docs.oracle.com/en/java/javase/21/docs/api", 
            //"javadoc" : "https://devdocs.io/openjdk~21/",
        }
    ],
    "redhat.telemetry.enabled": false,
    "java.codeGeneration.generateComments": true,
    "java.completion.enabled": true,
    "java.format.enabled": true,
    "java.codeGeneration.useBlocks": true,
    "files.exclude": {
        "**/.classpath": true,
        "**/.project": true,
        "**/.settings": true,
        "**/.factorypath": true
    },
    "workbench.editor.enablePreview": false,
    "hediet.vscode-drawio.resizeImages": null,
    "java.completion.favoriteStaticMembers": [
        "org.junit.Assert.*",
        "org.junit.Assume.*",
        "org.junit.jupiter.api.Assertions.*",
        "org.junit.jupiter.api.Assumptions.*",
        "org.junit.jupiter.api.DynamicContainer.*",
        "org.junit.jupiter.api.DynamicTest.*",
        "org.mockito.Mockito.*",
        "org.mockito.ArgumentMatchers.*",
        "org.mockito.Answers.*"
    ],
    "editor.minimap.size": "fit",
    "editor.minimap.enabled": false,
    "git.openRepositoryInParentFolders": "never",
    "java.debug.settings.exceptionBreakpoint.skipClasses": [   


    ],
    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml"
    },
    "[java]": {
        "editor.defaultFormatter": "redhat.java"
    },
    "jdk.telemetry.enabled": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "chat.agent.todoList": {

        "position": "default"
    },
    "window.menuBarVisibility": "compact",
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "java.maven.downloadSources": true,
    "workbench.settings.applyToAllProfiles": []
}